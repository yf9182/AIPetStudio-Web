# ---------------------------------------------------------------------------
# Copy to `.env.local` for local development. Never commit real values.
#
# On Cloudflare Workers these are set with:
#   npx wrangler secret put AUTH_SECRET
#   npx wrangler secret put MATERIAL_HUB_API_KEY
#   ...and so on. Public vars live in wrangler.jsonc.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# Public origin. Used for canonical URLs, OAuth redirects and Stripe returns.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth.js ----------------------------------------------------------------
# 32+ random characters: `openssl rand -base64 32`
# Also salts the derivation of the backend device id, so rotating it
# disconnects existing web accounts from their backend wallet.
AUTH_SECRET=""

# Google OAuth. Authorised redirect URI:
#   {NEXT_PUBLIC_SITE_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend API key used to send the email magic link. The Auth.js email provider
# is implemented against the Resend HTTP API because Workers has no SMTP.
AUTH_RESEND_KEY=""
EMAIL_FROM="AI Pet Studio <login@example.com>"

# --- Material Hub (素材中心) -------------------------------------------------
# Read-only product key for pid 8802. Server-side only: it must never reach the
# browser, which is why all catalog traffic is proxied through /api/catalog/*.
MATERIAL_HUB_BASE_URL="https://material-hub-nano-banana.yangf999212.workers.dev"
MATERIAL_HUB_API_KEY=""
MATERIAL_HUB_PID="8802"
MATERIAL_HUB_CHANNEL="English"
MATERIAL_HUB_SOURCE="English"

# --- AI Pet Studio backend Worker -------------------------------------------
WORKER_BASE_URL="https://ai-pet-studio-backend.yangf999212.workers.dev"

# --- Stripe -----------------------------------------------------------------
# Secret key for the web app (Checkout Sessions + Billing Portal).
# The Stripe webhook secret belongs to the backend Worker, not here.
STRIPE_SECRET_KEY=""

# Recurring subscription prices (price_...). Credit grants are declared in
# src/lib/billing/catalog.ts and mirror the backend's REVENUECAT_PRODUCTS.
STRIPE_PRICE_SUB_WEEKLY=""
STRIPE_PRICE_SUB_MONTHLY=""
STRIPE_PRICE_SUB_YEARLY=""

# One-off credit packs (price_...).
STRIPE_PRICE_CREDITS_100=""
STRIPE_PRICE_CREDITS_350=""
STRIPE_PRICE_CREDITS_900=""
STRIPE_PRICE_CREDITS_2200=""
